# Puter.js TTS (optional — only needed for `pnpm narrate`).
# No API key required: Puter SDK loads in a headless Chromium and runs
# txt2speech in browser context. Override the voice / engine / language
# below if Matthew + neural + en-US is not what you want.
PUTER_VOICE=Matthew
PUTER_ENGINE=neural
PUTER_LANG=en-US

# Used by Path B for capturing real browser sessions.
# Defaults to the Phase 1.5a tx hash; change per phase.
DEMO_TX_HASH=0xbaeb93856c4a660e06d0733b53f67c60d1fa59667fd5810e0c82cbf86ba8ac56
DEMO_SETTLEMENT_ADDRESS=0xf3F00F230aD037cA3b730b5E229495c085578c17

# Path B: terminal recording target — daemon URL for live demos
QUAESTOR_CORE_URL=http://127.0.0.1:3402
